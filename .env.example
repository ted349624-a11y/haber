# Vercel'de bunları Settings → Environment Variables bölümüne girin.
# Yerelde çalıştırırken bu dosyayı .env olarak kopyalayın. Gerçek değerleri ASLA repoya yüklemeyin.

# Web panel giriş kodu
WEB_CODE=
# Zamanlayıcının /api/tick adresini çağırırken kullanacağı gizli anahtar (uzun, rastgele bir metin)
CRON_SECRET=

X_BEARER_TOKEN=
ANTHROPIC_API_KEY=

# Borsa API anahtarı: SADECE "trade" yetkisi verin, "withdraw/çekim" yetkisini ASLA açmayın.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# İsteğe bağlı: config.yaml'daki modu ezmek için (dry_run | testnet | live)
TRADE_MODE=
# live mod için ayrıca: LIVE_ONAY=true

# Vercel'de Upstash Redis eklenince bunlar otomatik gelir:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
